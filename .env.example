# Required: your Raindrop write key. Every chat turn is sent to Raindrop as a `chat_message` event with its trace.
RAINDROP_WRITE_KEY=****

# Required: one model key. Use whichever you have.
OPENAI_API_KEY=****
# ANTHROPIC_API_KEY=****
# AI_GATEWAY_API_KEY=****   (https://vercel.com/ai-gateway: the model picker's models; takes precedence)

# Optional: the model to use with an OpenAI or Anthropic key. Defaults: gpt-6-luna, claude-sonnet-5-5.
# CHAT_MODEL=****

# Optional. Signs session cookies; a built-in test secret is used when unset. Set one for anything shared.
# AUTH_SECRET=****

# Optional: file uploads (https://vercel.com/docs/vercel-blob) and resumable streams (https://vercel.com/docs/redis).
# BLOB_READ_WRITE_TOKEN=****
# REDIS_URL=****
